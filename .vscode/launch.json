{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Rust Call Graph Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/fixtures/rust-demo"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js",
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "build"
    }
  ]
}
